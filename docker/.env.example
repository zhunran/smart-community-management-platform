# ══════════════════════════════════════════════════
# 智慧社区管理平台 — 环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已被 git 忽略，切勿提交）
#   cp .env.example .env
# ══════════════════════════════════════════════════

# === 数据库配置（所有模块共用）===
MYSQL_HOST=localhost
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# === XXL-Job 数据库配置 ===
XXL_MYSQL_USER=your_db_user
XXL_MYSQL_PASSWORD=your_db_password

# === Redis ===
REDIS_PASSWORD=your_redis_password

# === JWT 密钥（管理端与业主端使用不同密钥）===
# 生成方式：openssl rand -base64 64
JWT_ADMIN_SECRET=your_admin_jwt_secret
JWT_OWNER_SECRET=your_owner_jwt_secret
JWT_EXPIRATION=7200000            # Access Token：2 小时
JWT_REFRESH_EXPIRATION=604800000

# === 支付宝（默认沙箱，正式环境自行替换网关与密钥）===
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_MERCHANT_PRIVATE_KEY=your_alipay_merchant_private_key
ALIPAY_ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_NOTIFY_URL=https://your-domain/api/admin/payment/alipay/notify
ALIPAY_RETURN_URL=https://your-domain/api/admin/payment/alipay/return
ALIPAY_RETURN_WEB_URL=http://localhost:81/records

# === 邮件配置 ===
MAIL_USERNAME=your_mail_account
MAIL_PASSWORD=your_mail_password

# === DeepSeek AI 配置 ===
DEEPSEEK_API_KEY=your_deepseek_api_key

# === XXL-Job 调度配置 ===
XXL_JOB_ADMIN_ADDRESSES=http://localhost:9099/xxl-job-admin
XXL_JOB_EXECUTOR_IP=
XXL_JOB_ACCESS_TOKEN=your_xxl_job_access_token

# === 日志路径 ===
LOG_PATH=./logs

# === 功能开关（生产默认关闭 Swagger 与 SQL 日志）===
SWAGGER_ENABLED=false
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
