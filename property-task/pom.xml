<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.property</groupId>
        <artifactId>property-management</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>property-task</artifactId>
    <description>定时任务执行器——XXL-Job 执行器，独立部署</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.property</groupId>
            <artifactId>property-framework</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.property</groupId>
            <artifactId>property-module-bill</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.property</groupId>
            <artifactId>property-module-payment</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.property</groupId>
            <artifactId>property-module-lifeservice</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- 业主模块（查询业主邮箱） -->
        <dependency>
            <groupId>com.property</groupId>
            <artifactId>property-module-owner</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- 通知模块（邮件发送） -->
        <dependency>
            <groupId>com.property</groupId>
            <artifactId>property-module-notification</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- XXL-Job 核心依赖 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
